# ========================================================
# WISHFOR ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to activate live services.
# ========================================================

# 1. REAL TRANSACTIONAL EMAILS (Resend)
# Get a free API key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=
EMAIL_FROM=WishFor Sanctuary <onboarding@resend.dev>

# 2. REAL PHONE SMS OTP (Twilio Verify)
# Get credentials at https://www.twilio.com & create a Verify Service
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# 3. SUPABASE DATABASE & AUTH (Optional)
# Get credentials at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
