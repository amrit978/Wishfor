# ========================================================
# WISHFOR ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to activate live services.
# ========================================================

# 1. TRANSACTIONAL EMAILS (Option A: Gmail SMTP - No domain needed, sends to ANY recipient!)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 1. TRANSACTIONAL EMAILS (Option B: Resend API - Requires custom domain to send to others)
RESEND_API_KEY=
EMAIL_FROM=WishFor Sanctuary <onboarding@resend.dev>

# 2. REAL PHONE SMS OTP (Twilio Verify)
# Get credentials at https://www.twilio.com & create a Verify Service
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# 3. SUPABASE DATABASE & AUTH (Optional)
# Get credentials at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
